    <div class="nurse-phone-notch"></div>

    <div class="nurse-phone-content">

        <a href="@Url.Action("Logout", "Nurse")">← Back</a>

        <div class="card mt-3">
            <div class="card-body">
@* 
                @if (Model.Request.IsCritical)
                {
                    <span class="badge bg-danger mb-2">CRITICAL SURGE</span>
                }

                <h5 class="fw-bold">@Model.Request.Unit</h5>
                <div class="muted mb-3">@Model.Request.Description</div>

                <div class="row text-center mb-3">
                    <div class="col-6">
                        <div class="label">Duration</div>
                        <div class="fw-bold">@Model.Request.DurationHours hrs</div>
                    </div>
                    <div class="col-6">
                        <div class="label">Pay</div>
                        <div class="fw-bold text-info">@Model.Request.PayMultiplier x</div>
                    </div>
                </div>

                <div class="label mb-1">Location</div>
                <div class="muted mb-3">@Model.Request.Location</div>

                <form method="post" action="/Home/NurseAccept">
                    <input type="hidden" name="requestId" value="@Model.Request.Id" />
                    <button class="btn btn-success w-100 mb-2">
                        Accept & Respond
                    </button>
                </form>

                <form method="post" action="/Home/NurseDecline">
                    <input type="hidden" name="requestId" value="@Model.Request.Id" />
                    <button class="btn btn-outline-danger w-100">
                        Decline
                    </button>
                </form> *@
                <input id="negotiationId" value = "@ViewBag.NegotiationId" type="hidden"/>
                <div class="chat-shell">
                    <!-- Header -->
                    <div class="chat-header">
                        <div>
                            <h6>Surge Staffing Agent Negotiatior</h6>
@*                             <span class="sub">
                                Unit: @ViewBag.Unit | Nurse: @ViewBag.NurseName
                            </span> *@
                        </div>
                        <div class="badge bg-danger">CRITICAL</div> <!--remove the class status-->
                    </div>

                    <!-- Messages -->
                    <div id="chatWindow" class="chat-window"></div>

                    <!-- Input -->
                    <div class="chat-input">
                        <input id="nurseMessage"
                               placeholder="Type your reply..."
                               autocomplete="off" />
                        <button id="sendReply">Send</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script>
    const negotiationId = parseInt($("#negotiationId").val());

        function renderMessage(m) {

            if (m.sender !== "AI")
            {
                return `
                  <div class="msg HumanNurse">
                    <div class="bubble">
                      <span class="sender">You</span>
                      <div class="text">${m.message}</div>
                    </div>
                  </div>`;
            }
            else
            {
                return `
                  <div class="msg ${m.sender}">
                    <div class="bubble">
                      <span class="sender">${m.sender}</span>
                      <div class="text">${m.message}</div>
                    </div>
                  </div>`;
           }

    }

        function loadChat() {
        $.get("/Negotiation/GetMessages",
            { negotiationId },
            msgs => {
                $("#chatWindow").html("");
                msgs.forEach(m => {
                    $("#chatWindow").append(renderMessage(m));
                    console.log(m.sender);
                });
                $("#chatWindow").scrollTop(
                    $("#chatWindow")[0].scrollHeight
                );
            });
    }

    $("#sendReply").on("click", function () {
        const text = $("#nurseMessage").val();
        if (!text) return;

        const $btn = $(this);
        $btn.prop("disabled", true);

        $("#chatWindow").append(renderMessage({
            sender: "You",
            message: text
        }));

        $.ajax({
            url: "/Negotiation/NurseReply",
            type: "POST",
            data: {
                negotiationId: negotiationId,
                message: text
            }
        })
        .done(function () {
            $("#nurseMessage").val("");
            loadChat();
        })
        .fail(function (xhr) {
            alert(xhr.responseText || "Failed to send message");
        })
        .always(function () {
            $btn.prop("disabled", false);
        });
    });

    //setInterval(loadChat, 2000);
    loadChat();
    
</script>




