       $(function() {
             $("#btnTriggerSurge").click(function() {
                $.ajax({
                    url: '@Url.Action("TriggerSurge", "Home")', // Replace with your controller name
                    type: 'POST', // HTTP method
                    dataType: 'json', // Expecting JSON response
                    success: function(response) {

                        // Update the response message container with the success or error message
                        if (response.success) {
                            console.log(response.message); // Success message from the server
                              $.ajax({
                                     url: '/Home/StaffListPartial',
                                     type: 'POST',
                                     success: function (html) {
                                         $('#staffFeedScrollContainer').html(html); // 🔥 THIS is what updates the page
                                         window.location.reload();
                                         console.log("reload");
                                         $('#btnTriggerSurge').disabled = true;
                                     },
                                     error: function (xhr) {
                                         console.error(xhr.responseText);
                                         console.log("not reload");
                                     }
                                 });
                                 console.log("loaded");
                        } else {
                            console.log(response.message);
                            alert('Error: ' + response.message); // Error message from the server
                        }
                    },
                    error: function(xhr, status, error) {
                        console.log(response.message);
                        alert('Error: ' + error);
                    }
                });
            });
        });
